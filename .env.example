# ── お問合せフォームのメール送信（Resend） ───────────────────
# https://resend.com でAPIキーを発行し、Vercel の Environment Variables に設定する。
RESEND_API_KEY=
# 認証済みドメインの送信元。未設定だと Resend の共有ドメインから送信される。
CONTACT_FROM_EMAIL="APOLLO <noreply@apollone.jp>"
# 受信先。未設定なら contact@apollone.jp
CONTACT_TO_EMAIL=contact@apollone.jp

# ── microCMS（制作実績 works のみ） ──────────────────────────
# 未設定の場合は lib/works.ts の静的データで表示される。
MICROCMS_SERVICE_DOMAIN=
MICROCMS_API_KEY=

# ── サイトURL（OGP・canonical用） ────────────────────────────
NEXT_PUBLIC_SITE_URL=https://apollone.jp

# ── ヒーロー動画 ─────────────────────────────────────────────
# public/hero/hero.mp4 に置いた場合は /hero/hero.mp4 を指定する。
# 外部URL（Vercel Blob 等）でも可。未設定なら静止画のまま。
NEXT_PUBLIC_HERO_VIDEO=
